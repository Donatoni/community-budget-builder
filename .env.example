# Copy this file to .env.local (used by `npm run dev` and `npm run preview`)
# and to .dev.vars (used by `npx wrangler pages dev`). Both are ignored by Git.
# Real values never belong in this file or anywhere else in the repository.

# Production builds use the public address set in src/seo.js.
# Optional override for a plain `npm run build` (no path, query or fragment).
# `npm run build:cloudflare` and `npm run deploy` always use src/seo.js.
# SITE_URL=https://budget.example.gov/
# Use true when publishing any preview build so search engines skip it.
SEO_NOINDEX=false

# Shared reviewer sign-in for the coming-soon period (server only).
# In production, set these as encrypted secrets in Cloudflare Pages.
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=
# Random signing secret, at least 32 characters.
REVIEWER_SESSION_SECRET=

# Optional temporary dashboard recovery administrator. Normal staff accounts
# are stored in the DASHBOARD_DB database. Leave these unset during ordinary
# operation; if needed for recovery, use a long random password and remove
# both values afterward.
ADMIN_EMAIL=
ADMIN_PASSWORD=
