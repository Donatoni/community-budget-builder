{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Your Cloudflare Pages project name. `npm run deploy` reads it from here.
  "name": "your-city-budget",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-15",
  // Create both databases with `npx wrangler d1 create <database_name>` and
  // paste the IDs Wrangler prints. See DEPLOYMENT.md.
  "d1_databases": [
    {
      "binding": "DASHBOARD_DB",
      "database_name": "your-city-budget-dashboard",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DASHBOARD_DB",
          "database_name": "your-city-budget-dashboard-preview",
          "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
